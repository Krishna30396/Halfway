# --- Routing: OpenRouteService (free key, no card) ---------------------------
# Sign up at openrouteservice.org/dev — free plan is ~2,000 requests/day.
# Leave ORS_API_KEY empty to fall back to the keyless OSRM demo server (local dev only).
ROUTER=openrouteservice
ORS_API_KEY=
ORS_URL=https://api.openrouteservice.org
# Keyless fallback for local development only:
OSRM_URL=https://router.project-osrm.org

# --- Tiles: Stadia Maps (free key, no card) ----------------------------------
# Sign up at stadiamaps.com — free tier is ~200k tile loads/month.
# NOTE: this key IS exposed in the browser (by design; protect via domain allowlist).
# Leave NEXT_PUBLIC_STADIA_API_KEY empty to fall back to keyless OSM raster tiles.
NEXT_PUBLIC_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_STADIA_API_KEY=
NEXT_PUBLIC_TILE_ATTRIBUTION=© Stadia Maps © OpenMapTiles © OpenStreetMap contributors

# --- Geocoding: Photon (no key) ----------------------------------------------
GEOCODER=photon
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Places: Overpass (no key) -----------------------------------------------
PLACES_PROVIDER=overpass
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter

# Required by Nominatim's usage policy if the fallback geocoder is used.
CONTACT_EMAIL=you@example.com

# --- Supabase (required for auth + saved searches) --------------------------
# Create a free project at supabase.com, then:
# 1. Copy the URL and anon key from Settings → API
# 2. Run supabase-schema.sql in the SQL Editor
# 3. Enable Google OAuth in Authentication → Providers (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (Settings → API → service_role). NEVER prefix with NEXT_PUBLIC_.
# Used by /api/notify to look up the other person's devices.
SUPABASE_SERVICE_ROLE_KEY=

# --- Push notifications (Web Push / VAPID, free) -----------------------------
# Generate a pair once with:  npx web-push generate-vapid-keys
# The public key goes to the browser; the private key stays on the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Native app push (Firebase Cloud Messaging, free) ------------------------
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, or base64-encode it. Server-only. Optional:
# without it the Android app gets no push (Web Push above still works).
FIREBASE_SERVICE_ACCOUNT=
